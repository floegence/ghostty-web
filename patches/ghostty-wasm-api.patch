new file mode 100644
index 000000000..c23eed0d5
--- /dev/null
+++ b/src/terminal/checkpoint.zig
@@ -0,0 +1,933 @@
+//! Durable logical terminal checkpoint codec for the floegence Ghostty WASM fork.
+//!
+//! The format is deliberately independent of Zig struct and WASM memory layouts.
+//! It serializes terminal-owned logical values and reconstructs into a temporary
+//! Terminal so callers can atomically replace live state only after validation.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+const Terminal = @import("Terminal.zig");
+const Screen = @import("Screen.zig");
+const ScreenSet = @import("ScreenSet.zig");
+const pagepkg = @import("page.zig");
+const stylepkg = @import("style.zig");
+const hyperlink = @import("hyperlink.zig");
+const color = @import("color.zig");
+const modespkg = @import("modes.zig");
+const ansi = @import("ansi.zig");
+const charsets = @import("charsets.zig");
+const kitty = @import("kitty.zig");
+const ModeBacking = @typeInfo(modespkg.ModePacked).@"struct".backing_integer.?;
+
+pub const format_version: u16 = 1;
+pub const magic = "FLOE-GHOSTTY-CKPT";
+pub const engine_id = "floegence/ghostty-web@1858a594+ghostty@5714ed07";
+pub const header_len = magic.len + 2 + 2 + 4 + 4 + 8 + 8 + 8 + 8 + 32;
+pub const max_checkpoint_bytes: usize = 64 * 1024 * 1024;
+const max_dimension: u32 = 4096;
+const max_total_rows: u32 = 1_000_000;
+const max_string_bytes: u32 = 16 * 1024 * 1024;
+const max_grapheme_codepoints: u16 = 256;
+const max_explicit_screen_bytes: u64 = std.math.maxInt(u32);
+
+pub const Error = error{
+    InvalidFormat,
+    UnsupportedVersion,
+    ChecksumMismatch,
+    DimensionMismatch,
+    ResourceLimit,
+    StateInvariant,
+    OutOfMemory,
+};
+
+pub const Metadata = struct {
+    cols: u32,
+    rows: u32,
+    coordinates: Coordinates,
+    payload_len: usize,
+    checksum: [32]u8,
+};
+
+pub const Coordinates = struct {
+    history_sequence: u64 = 0,
+    geometry_generation: u64 = 0,
+    parser_epoch: u64 = 0,
+};
+
+pub const Decoded = struct {
+    terminal: Terminal,
+    response: []u8,
+
+    pub fn deinit(self: *Decoded, alloc: Allocator) void {
+        self.terminal.deinit(alloc);
+        alloc.free(self.response);
+        self.* = undefined;
+    }
+};
+
+const Encoder = struct {
+    alloc: Allocator,
+    bytes: std.ArrayList(u8) = .empty,
+
+    fn deinit(self: *Encoder) void {
+        self.bytes.deinit(self.alloc);
+    }
+
+    fn byte(self: *Encoder, value: u8) Error!void {
+        self.bytes.append(self.alloc, value) catch return error.OutOfMemory;
+    }
+
+    fn uint(self: *Encoder, comptime T: type, value: T) Error!void {
+        var buf: [@sizeOf(T)]u8 = undefined;
+        std.mem.writeInt(T, &buf, value, .little);
+        self.bytes.appendSlice(self.alloc, &buf) catch return error.OutOfMemory;
+    }
+
+    fn boolean(self: *Encoder, value: bool) Error!void {
+        try self.byte(@intFromBool(value));
+    }
+
+    fn slice(self: *Encoder, value: []const u8) Error!void {
+        if (value.len > max_string_bytes) return error.ResourceLimit;
+        try self.uint(u32, @intCast(value.len));
+        self.bytes.appendSlice(self.alloc, value) catch return error.OutOfMemory;
+    }
+};
+
+const Decoder = struct {
+    bytes: []const u8,
+    offset: usize = 0,
+
+    fn remaining(self: *const Decoder) usize {
+        return self.bytes.len - self.offset;
+    }
+
+    fn byte(self: *Decoder) Error!u8 {
+        if (self.remaining() < 1) return error.InvalidFormat;
+        defer self.offset += 1;
+        return self.bytes[self.offset];
+    }
+
+    fn uint(self: *Decoder, comptime T: type) Error!T {
+        if (self.remaining() < @sizeOf(T)) return error.InvalidFormat;
+        const value = std.mem.readInt(T, self.bytes[self.offset..][0..@sizeOf(T)], .little);
+        self.offset += @sizeOf(T);
+        return value;
+    }
+
+    fn boolean(self: *Decoder) Error!bool {
+        return switch (try self.byte()) {
+            0 => false,
+            1 => true,
+            else => error.InvalidFormat,
+        };
+    }
+
+    fn slice(self: *Decoder) Error![]const u8 {
+        const len = try self.uint(u32);
+        if (len > max_string_bytes or self.remaining() < len) return error.ResourceLimit;
+        const value = self.bytes[self.offset..][0..len];
+        self.offset += len;
+        return value;
+    }
+
+    fn finish(self: *const Decoder) Error!void {
+        if (self.offset != self.bytes.len) return error.InvalidFormat;
+    }
+};
+
+pub fn metadata(bytes: []const u8) Error!Metadata {
+    if (bytes.len < header_len or bytes.len > max_checkpoint_bytes) return error.InvalidFormat;
+    if (!std.mem.eql(u8, bytes[0..magic.len], magic)) return error.InvalidFormat;
+
+    var dec: Decoder = .{ .bytes = bytes, .offset = magic.len };
+    if (try dec.uint(u16) != format_version) return error.UnsupportedVersion;
+    if (try dec.uint(u16) != header_len) return error.InvalidFormat;
+    const cols = try dec.uint(u32);
+    const rows = try dec.uint(u32);
+    const coordinates: Coordinates = .{
+        .history_sequence = try dec.uint(u64),
+        .geometry_generation = try dec.uint(u64),
+        .parser_epoch = try dec.uint(u64),
+    };
+    const payload_len = try dec.uint(u64);
+    if (cols == 0 or rows == 0 or cols > max_dimension or rows > max_dimension) return error.ResourceLimit;
+    if (payload_len > max_checkpoint_bytes or payload_len != bytes.len - header_len) return error.InvalidFormat;
+    var expected: [32]u8 = undefined;
+    @memcpy(&expected, bytes[dec.offset..][0..32]);
+    dec.offset += 32;
+
+    var actual: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes[header_len..], &actual, .{});
+    if (!std.crypto.timing_safe.eql([32]u8, expected, actual)) return error.ChecksumMismatch;
+    return .{
+        .cols = cols,
+        .rows = rows,
+        .coordinates = coordinates,
+        .payload_len = @intCast(payload_len),
+        .checksum = expected,
+    };
+}
+
+pub fn capture(
+    alloc: Allocator,
+    terminal: *const Terminal,
+    response: []const u8,
+    coordinates: Coordinates,
+) Error![]u8 {
+    var payload: Encoder = .{ .alloc = alloc };
+    defer payload.deinit();
+
+    try payload.slice(engine_id);
+    try payload.uint(u32, terminal.cols);
+    try payload.uint(u32, terminal.rows);
+    try payload.uint(u32, terminal.width_px);
+    try payload.uint(u32, terminal.height_px);
+    try payload.byte(@intCast(@intFromEnum(terminal.status_display)));
+    try payload.uint(u32, terminal.scrolling_region.top);
+    try payload.uint(u32, terminal.scrolling_region.bottom);
+    try payload.uint(u32, terminal.scrolling_region.left);
+    try payload.uint(u32, terminal.scrolling_region.right);
+    try payload.slice(terminal.pwd.items);
+    try encodeColors(&payload, terminal.colors);
+    try payload.boolean(terminal.previous_char != null);
+    if (terminal.previous_char) |cp| try payload.uint(u32, cp);
+    try payload.uint(u64, @intCast(@as(ModeBacking, @bitCast(terminal.modes.values))));
+    try payload.uint(u64, @intCast(@as(ModeBacking, @bitCast(terminal.modes.saved))));
+    try payload.uint(u64, @intCast(@as(ModeBacking, @bitCast(terminal.modes.default))));
+    try payload.uint(u32, @intCast(@intFromEnum(terminal.mouse_shape)));
+    try payload.boolean(terminal.flags.shell_redraws_prompt);
+    try payload.boolean(terminal.flags.modify_other_keys_2);
+    try payload.byte(@intFromEnum(terminal.flags.mouse_event));
+    try payload.byte(@intFromEnum(terminal.flags.mouse_format));
+    try payload.byte(@intFromEnum(terminal.flags.mouse_shift_capture));
+    try payload.boolean(terminal.flags.focused);
+    try payload.boolean(terminal.flags.password_input);
+    try payload.boolean(terminal.flags.selection_scroll);
+    for (0..terminal.cols) |col| try payload.boolean(terminal.tabstops.get(col));
+    try payload.byte(@intFromEnum(terminal.screens.active_key));
+    try encodeScreen(&payload, terminal.screens.get(.primary).?);
+    try payload.boolean(terminal.screens.get(.alternate) != null);
+    if (terminal.screens.get(.alternate)) |screen| try encodeScreen(&payload, screen);
+    try payload.slice(response);
+
+    if (payload.bytes.items.len + header_len > max_checkpoint_bytes) return error.ResourceLimit;
+    var checksum: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(payload.bytes.items, &checksum, .{});
+
+    var out: Encoder = .{ .alloc = alloc };
+    errdefer out.deinit();
+    out.bytes.appendSlice(alloc, magic) catch return error.OutOfMemory;
+    try out.uint(u16, format_version);
+    try out.uint(u16, header_len);
+    try out.uint(u32, terminal.cols);
+    try out.uint(u32, terminal.rows);
+    try out.uint(u64, coordinates.history_sequence);
+    try out.uint(u64, coordinates.geometry_generation);
+    try out.uint(u64, coordinates.parser_epoch);
+    try out.uint(u64, payload.bytes.items.len);
+    out.bytes.appendSlice(alloc, &checksum) catch return error.OutOfMemory;
+    out.bytes.appendSlice(alloc, payload.bytes.items) catch return error.OutOfMemory;
+    return out.bytes.toOwnedSlice(alloc) catch return error.OutOfMemory;
+}
+
+pub fn decode(
+    alloc: Allocator,
+    bytes: []const u8,
+    expected_cols: ?u32,
+    expected_rows: ?u32,
+    expected_coordinates: ?Coordinates,
+) Error!Decoded {
+    const meta = try metadata(bytes);
+    if (expected_cols) |cols| if (cols != meta.cols) return error.DimensionMismatch;
+    if (expected_rows) |rows| if (rows != meta.rows) return error.DimensionMismatch;
+    if (expected_coordinates) |expected| {
+        if (expected.history_sequence != meta.coordinates.history_sequence or
+            expected.geometry_generation != meta.coordinates.geometry_generation or
+            expected.parser_epoch != meta.coordinates.parser_epoch) return error.StateInvariant;
+    }
+
+    var dec: Decoder = .{ .bytes = bytes[header_len..] };
+    if (!std.mem.eql(u8, try dec.slice(), engine_id)) return error.UnsupportedVersion;
+    const cols = try dec.uint(u32);
+    const rows = try dec.uint(u32);
+    if (cols != meta.cols or rows != meta.rows) return error.InvalidFormat;
+
+    var terminal = Terminal.init(alloc, .{
+        .cols = @intCast(cols),
+        .rows = @intCast(rows),
+        .max_scrollback = std.math.maxInt(usize),
+    }) catch return error.OutOfMemory;
+    errdefer terminal.deinit(alloc);
+
+    terminal.width_px = try dec.uint(u32);
+    terminal.height_px = try dec.uint(u32);
+    terminal.status_display = std.meta.intToEnum(ansi.StatusDisplay, try dec.byte()) catch return error.StateInvariant;
+    const scrolling_top = try dec.uint(u32);
+    const scrolling_bottom = try dec.uint(u32);
+    const scrolling_left = try dec.uint(u32);
+    const scrolling_right = try dec.uint(u32);
+    if (scrolling_top >= scrolling_bottom or scrolling_bottom >= rows or
+        scrolling_left >= scrolling_right or scrolling_right >= cols) return error.StateInvariant;
+    terminal.scrolling_region = .{
+        .top = @intCast(scrolling_top),
+        .bottom = @intCast(scrolling_bottom),
+        .left = @intCast(scrolling_left),
+        .right = @intCast(scrolling_right),
+    };
+    const pwd = try dec.slice();
+    terminal.pwd.appendSlice(alloc, pwd) catch return error.OutOfMemory;
+    terminal.colors = try decodeColors(&dec);
+    terminal.previous_char = if (try dec.boolean()) previous: {
+        const cp = try dec.uint(u32);
+        if (cp > 0x10ffff or (cp >= 0xd800 and cp <= 0xdfff)) return error.StateInvariant;
+        break :previous @intCast(cp);
+    } else null;
+    terminal.modes.values = @bitCast(try decodeModeBacking(&dec));
+    terminal.modes.saved = @bitCast(try decodeModeBacking(&dec));
+    terminal.modes.default = @bitCast(try decodeModeBacking(&dec));
+    const mouse_shape_raw = try dec.uint(u32);
+    if (mouse_shape_raw > std.math.maxInt(c_int)) return error.StateInvariant;
+    terminal.mouse_shape = std.meta.intToEnum(
+        @TypeOf(terminal.mouse_shape),
+        @as(c_int, @intCast(mouse_shape_raw)),
+    ) catch return error.StateInvariant;
+    terminal.flags.shell_redraws_prompt = try dec.boolean();
+    terminal.flags.modify_other_keys_2 = try dec.boolean();
+    terminal.flags.mouse_event = std.meta.intToEnum(Terminal.MouseEvents, try dec.byte()) catch return error.StateInvariant;
+    terminal.flags.mouse_format = std.meta.intToEnum(Terminal.MouseFormat, try dec.byte()) catch return error.StateInvariant;
+    terminal.flags.mouse_shift_capture = std.meta.intToEnum(
+        @TypeOf(terminal.flags.mouse_shift_capture),
+        try dec.byte(),
+    ) catch return error.StateInvariant;
+    terminal.flags.focused = try dec.boolean();
+    terminal.flags.password_input = try dec.boolean();
+    terminal.flags.selection_scroll = try dec.boolean();
+    terminal.tabstops.reset(0);
+    for (0..terminal.cols) |col| if (try dec.boolean()) terminal.tabstops.set(col);
+
+    const active_key = std.meta.intToEnum(ScreenSet.Key, try dec.byte()) catch return error.StateInvariant;
+    try decodeScreen(alloc, &terminal, terminal.screens.get(.primary).?, &dec);
+    const has_alternate = try dec.boolean();
+    if (has_alternate) {
+        const alternate = terminal.screens.getInit(alloc, .alternate, .{
+            .cols = terminal.cols,
+            .rows = terminal.rows,
+            .max_scrollback = 0,
+        }) catch return error.OutOfMemory;
+        try decodeScreen(alloc, &terminal, alternate, &dec);
+    } else if (active_key == .alternate) return error.StateInvariant;
+    terminal.screens.switchTo(active_key);
+
+    const response_src = try dec.slice();
+    const response = alloc.dupe(u8, response_src) catch return error.OutOfMemory;
+    errdefer alloc.free(response);
+    try dec.finish();
+    return .{ .terminal = terminal, .response = response };
+}
+
+fn encodeColors(enc: *Encoder, colors: Terminal.Colors) Error!void {
+    try encodeDynamicRgb(enc, colors.background);
+    try encodeDynamicRgb(enc, colors.foreground);
+    try encodeDynamicRgb(enc, colors.cursor);
+    for (colors.palette.original) |rgb| try encodeRgb(enc, rgb);
+    for (colors.palette.current) |rgb| try encodeRgb(enc, rgb);
+}
+
+fn decodeColors(dec: *Decoder) Error!Terminal.Colors {
+    var result: Terminal.Colors = .default;
+    result.background = try decodeDynamicRgb(dec);
+    result.foreground = try decodeDynamicRgb(dec);
+    result.cursor = try decodeDynamicRgb(dec);
+    for (&result.palette.original) |*rgb| rgb.* = try decodeRgb(dec);
+    result.palette.current = result.palette.original;
+    result.palette.resetAll();
+    for (0..256) |i| {
+        const rgb = try decodeRgb(dec);
+        if (rgb != result.palette.original[i]) result.palette.set(@intCast(i), rgb);
+    }
+    return result;
+}
+
+fn encodeDynamicRgb(enc: *Encoder, value: color.DynamicRGB) Error!void {
+    try enc.boolean(value.default != null);
+    if (value.default) |rgb| try encodeRgb(enc, rgb);
+    try enc.boolean(value.override != null);
+    if (value.override) |rgb| try encodeRgb(enc, rgb);
+}
+
+fn decodeDynamicRgb(dec: *Decoder) Error!color.DynamicRGB {
+    return .{
+        .default = if (try dec.boolean()) try decodeRgb(dec) else null,
+        .override = if (try dec.boolean()) try decodeRgb(dec) else null,
+    };
+}
+
+fn encodeRgb(enc: *Encoder, rgb: color.RGB) Error!void {
+    try enc.byte(rgb.r);
+    try enc.byte(rgb.g);
+    try enc.byte(rgb.b);
+}
+
+fn decodeRgb(dec: *Decoder) Error!color.RGB {
+    return .{ .r = try dec.byte(), .g = try dec.byte(), .b = try dec.byte() };
+}
+
+fn decodeModeBacking(dec: *Decoder) Error!ModeBacking {
+    const raw = try dec.uint(u64);
+    if (@bitSizeOf(ModeBacking) < 64 and raw > std.math.maxInt(ModeBacking))
+        return error.StateInvariant;
+    return @truncate(raw);
+}
+
+fn encodeStyle(enc: *Encoder, value: stylepkg.Style) Error!void {
+    try encodeStyleColor(enc, value.fg_color);
+    try encodeStyleColor(enc, value.bg_color);
+    try encodeStyleColor(enc, value.underline_color);
+    try enc.uint(u16, @bitCast(value.flags));
+}
+
+fn decodeStyle(dec: *Decoder) Error!stylepkg.Style {
+    var result: stylepkg.Style = .{};
+    result.fg_color = try decodeStyleColor(dec);
+    result.bg_color = try decodeStyleColor(dec);
+    result.underline_color = try decodeStyleColor(dec);
+    result.flags = @bitCast(try dec.uint(u16));
+    return result;
+}
+
+fn encodeStyleColor(enc: *Encoder, value: stylepkg.Style.Color) Error!void {
+    switch (value) {
+        .none => try enc.byte(0),
+        .palette => |idx| {
+            try enc.byte(1);
+            try enc.byte(idx);
+        },
+        .rgb => |rgb| {
+            try enc.byte(2);
+            try encodeRgb(enc, rgb);
+        },
+    }
+}
+
+fn decodeStyleColor(dec: *Decoder) Error!stylepkg.Style.Color {
+    return switch (try dec.byte()) {
+        0 => .none,
+        1 => .{ .palette = try dec.byte() },
+        2 => .{ .rgb = try decodeRgb(dec) },
+        else => error.StateInvariant,
+    };
+}
+
+fn encodeCharset(enc: *Encoder, value: Screen.CharsetState) Error!void {
+    inline for (.{ charsets.Slots.G0, charsets.Slots.G1, charsets.Slots.G2, charsets.Slots.G3 }) |slot|
+        try enc.byte(@intCast(@intFromEnum(value.charsets.get(slot))));
+    try enc.byte(@intCast(@intFromEnum(value.gl)));
+    try enc.byte(@intCast(@intFromEnum(value.gr)));
+    try enc.boolean(value.single_shift != null);
+    if (value.single_shift) |slot| try enc.byte(@intCast(@intFromEnum(slot)));
+}
+
+fn decodeCharset(dec: *Decoder) Error!Screen.CharsetState {
+    var result: Screen.CharsetState = .{};
+    inline for (.{ charsets.Slots.G0, charsets.Slots.G1, charsets.Slots.G2, charsets.Slots.G3 }) |slot|
+        result.charsets.set(slot, std.meta.intToEnum(charsets.Charset, try dec.byte()) catch return error.StateInvariant);
+    result.gl = std.meta.intToEnum(charsets.Slots, try dec.byte()) catch return error.StateInvariant;
+    result.gr = std.meta.intToEnum(charsets.Slots, try dec.byte()) catch return error.StateInvariant;
+    result.single_shift = if (try dec.boolean())
+        std.meta.intToEnum(charsets.Slots, try dec.byte()) catch return error.StateInvariant
+    else
+        null;
+    return result;
+}
+
+fn encodeCursor(enc: *Encoder, cursor: Screen.Cursor) Error!void {
+    try enc.uint(u32, cursor.x);
+    try enc.uint(u32, cursor.y);
+    try enc.byte(@intFromEnum(cursor.cursor_style));
+    try enc.boolean(cursor.pending_wrap);
+    try enc.boolean(cursor.protected);
+    try encodeStyle(enc, cursor.style);
+    try enc.uint(u32, cursor.hyperlink_implicit_id);
+    try enc.boolean(cursor.hyperlink != null);
+    if (cursor.hyperlink) |link| try encodeHyperlink(enc, link.*);
+}
+
+fn encodeSavedCursor(enc: *Encoder, cursor: ?Screen.SavedCursor) Error!void {
+    try enc.boolean(cursor != null);
+    if (cursor) |value| {
+        try enc.uint(u32, value.x);
+        try enc.uint(u32, value.y);
+        try encodeStyle(enc, value.style);
+        try enc.boolean(value.protected);
+        try enc.boolean(value.pending_wrap);
+        try enc.boolean(value.origin);
+        try encodeCharset(enc, value.charset);
+    }
+}
+
+fn encodeHyperlink(enc: *Encoder, link: hyperlink.Hyperlink) Error!void {
+    switch (link.id) {
+        .implicit => |id| {
+            try enc.byte(1);
+            try enc.uint(u32, id);
+        },
+        .explicit => |id| {
+            try enc.byte(2);
+            try enc.slice(id);
+        },
+    }
+    try enc.slice(link.uri);
+}
+
+fn encodeScreen(enc: *Encoder, screen: *const Screen) Error!void {
+    if (screen.pages.total_rows > max_total_rows) return error.ResourceLimit;
+    try enc.boolean(screen.no_scrollback);
+    try enc.uint(u64, screen.pages.explicit_max_size);
+    try enc.uint(u32, @intCast(screen.pages.total_rows));
+    try encodeCursor(enc, screen.cursor);
+    try encodeSavedCursor(enc, screen.saved_cursor);
+    try encodeCharset(enc, screen.charset);
+    try enc.byte(@intFromEnum(screen.protected_mode));
+    for (screen.kitty_keyboard.flags) |flags| try enc.byte(flags.int());
+    try enc.byte(screen.kitty_keyboard.idx);
+
+    var rows = screen.pages.rowIterator(.right_down, .{ .screen = .{} }, null);
+    while (rows.next()) |pin| {
+        const rac = pin.rowAndCell();
+        try enc.boolean(rac.row.wrap);
+        try enc.boolean(rac.row.wrap_continuation);
+        try enc.byte(@intFromEnum(rac.row.semantic_prompt));
+        try enc.boolean(rac.row.kitty_virtual_placeholder);
+        const cells = pin.cells(.all);
+        if (cells.len != screen.pages.cols) return error.StateInvariant;
+        for (cells) |*cell| try encodeCell(enc, pin, cell);
+    }
+}
+
+fn encodeCell(enc: *Encoder, pin: @import("PageList.zig").Pin, cell: *const pagepkg.Cell) Error!void {
+    try enc.byte(@intFromEnum(cell.content_tag));
+    const content: u32 = switch (cell.content_tag) {
+        .codepoint, .codepoint_grapheme => cell.content.codepoint,
+        .bg_color_palette => cell.content.color_palette,
+        .bg_color_rgb => (@as(u32, cell.content.color_rgb.r) << 16) | (@as(u32, cell.content.color_rgb.g) << 8) | cell.content.color_rgb.b,
+    };
+    try enc.uint(u32, content);
+    try enc.byte(@intFromEnum(cell.wide));
+    try enc.boolean(cell.protected);
+    try encodeStyle(enc, pin.style(cell));
+    const grapheme = pin.grapheme(cell) orelse &.{};
+    if (grapheme.len > max_grapheme_codepoints) return error.ResourceLimit;
+    try enc.uint(u16, @intCast(grapheme.len));
+    for (grapheme) |cp| try enc.uint(u32, cp);
+    try enc.boolean(cell.hyperlink);
+    if (cell.hyperlink) {
+        const page = &pin.node.data;
+        const id = page.lookupHyperlink(cell) orelse return error.StateInvariant;
+        const entry = page.hyperlink_set.get(page.memory, id);
+        const logical: hyperlink.Hyperlink = .{
+            .id = switch (entry.id) {
+                .implicit => |value| .{ .implicit = value },
+                .explicit => |value| .{ .explicit = value.slice(page.memory) },
+            },
+            .uri = entry.uri.slice(page.memory),
+        };
+        try encodeHyperlink(enc, logical);
+    }
+}
+
+fn decodeScreen(alloc: Allocator, terminal: *Terminal, screen: *Screen, dec: *Decoder) Error!void {
+    const no_scrollback = try dec.boolean();
+    const explicit_max_size = try dec.uint(u64);
+    if (explicit_max_size > max_explicit_screen_bytes or
+        explicit_max_size > std.math.maxInt(usize)) return error.ResourceLimit;
+    const total_rows = try dec.uint(u32);
+    if (total_rows < terminal.rows or total_rows > max_total_rows) return error.ResourceLimit;
+
+    const cursor_x = try dec.uint(u32);
+    const cursor_y = try dec.uint(u32);
+    const cursor_style = std.meta.intToEnum(Screen.CursorStyle, try dec.byte()) catch return error.StateInvariant;
+    const pending_wrap = try dec.boolean();
+    const cursor_protected = try dec.boolean();
+    const cursor_pen = try decodeStyle(dec);
+    const hyperlink_implicit_id = try dec.uint(u32);
+    const has_cursor_link = try dec.boolean();
+    const cursor_link = if (has_cursor_link) try decodeOwnedHyperlink(alloc, dec) else null;
+    defer if (cursor_link) |*link| link.deinit(alloc);
+
+    const saved = try decodeSavedCursor(dec, terminal.cols, terminal.rows);
+    const charset = try decodeCharset(dec);
+    const protected_mode = std.meta.intToEnum(ansi.ProtectedMode, try dec.byte()) catch return error.StateInvariant;
+    var kitty_keyboard: kitty.KeyFlagStack = .{};
+    for (&kitty_keyboard.flags) |*flags| {
+        const raw = try dec.byte();
+        if (raw > std.math.maxInt(u5)) return error.StateInvariant;
+        flags.* = @bitCast(@as(u5, @intCast(raw)));
+    }
+    const kitty_idx = try dec.byte();
+    if (kitty_idx >= kitty_keyboard.flags.len) return error.StateInvariant;
+    kitty_keyboard.idx = @intCast(kitty_idx);
+
+    while (screen.pages.total_rows < total_rows) _ = screen.pages.grow() catch return error.OutOfMemory;
+    if (screen.pages.total_rows != total_rows) return error.StateInvariant;
+
+    for (0..total_rows) |y| {
+        var pin = screen.pages.pin(.{ .screen = .{ .y = @intCast(y) } }) orelse return error.StateInvariant;
+        var rac = pin.rowAndCell();
+        rac.row.wrap = try dec.boolean();
+        rac.row.wrap_continuation = try dec.boolean();
+        rac.row.semantic_prompt = std.meta.intToEnum(pagepkg.Row.SemanticPrompt, try dec.byte()) catch return error.StateInvariant;
+        rac.row.kitty_virtual_placeholder = try dec.boolean();
+        for (0..terminal.cols) |x| {
+            try decodeCell(screen, dec, @intCast(y), @intCast(x));
+            pin = screen.pages.pin(.{ .screen = .{ .y = @intCast(y), .x = @intCast(x) } }) orelse return error.StateInvariant;
+            rac = pin.rowAndCell();
+            rac.row.dirty = true;
+        }
+    }
+
+    if (cursor_x >= terminal.cols or cursor_y >= terminal.rows) return error.StateInvariant;
+    // Growing and filling the page list leaves the initial cursor pin on its
+    // old page. Reload it into the active viewport before applying the
+    // serialized point; otherwise subsequent writes can mutate invisible
+    // history rows.
+    screen.cursorReload();
+    screen.cursorAbsolute(@intCast(cursor_x), @intCast(cursor_y));
+    screen.cursor.cursor_style = cursor_style;
+    screen.cursor.pending_wrap = pending_wrap;
+    screen.cursor.protected = cursor_protected;
+    screen.cursor.style = cursor_pen;
+    screen.cursor.style_id = addCursorStyle(screen, cursor_pen) catch return error.OutOfMemory;
+    screen.cursor.hyperlink_implicit_id = hyperlink_implicit_id;
+    if (cursor_link) |link| {
+        switch (link.id) {
+            .implicit => |id| screen.cursor.hyperlink_implicit_id = id,
+            .explicit => {},
+        }
+        screen.startHyperlink(link.uri, switch (link.id) {
+            .explicit => |id| id,
+            .implicit => null,
+        }) catch return error.OutOfMemory;
+        screen.cursor.hyperlink_implicit_id = hyperlink_implicit_id;
+    }
+    screen.saved_cursor = saved;
+    screen.charset = charset;
+    screen.protected_mode = protected_mode;
+    screen.kitty_keyboard = kitty_keyboard;
+    screen.no_scrollback = no_scrollback;
+    screen.pages.explicit_max_size = @intCast(explicit_max_size);
+    screen.pages.clearDirty();
+    var node = screen.pages.pages.first;
+    while (node) |page| : (node = page.next) page.data.dirty = true;
+}
+
+fn decodeSavedCursor(dec: *Decoder, cols: u32, rows: u32) Error!?Screen.SavedCursor {
+    if (!try dec.boolean()) return null;
+    const x = try dec.uint(u32);
+    const y = try dec.uint(u32);
+    if (x >= cols or y >= rows) return error.StateInvariant;
+    return .{
+        .x = @intCast(x),
+        .y = @intCast(y),
+        .style = try decodeStyle(dec),
+        .protected = try dec.boolean(),
+        .pending_wrap = try dec.boolean(),
+        .origin = try dec.boolean(),
+        .charset = try decodeCharset(dec),
+    };
+}
+
+fn decodeOwnedHyperlink(alloc: Allocator, dec: *Decoder) Error!hyperlink.Hyperlink {
+    const tag = try dec.byte();
+    const id: hyperlink.Hyperlink.Id = switch (tag) {
+        1 => .{ .implicit = try dec.uint(u32) },
+        2 => .{ .explicit = alloc.dupe(u8, try dec.slice()) catch return error.OutOfMemory },
+        else => return error.StateInvariant,
+    };
+    errdefer switch (id) {
+        .implicit => {},
+        .explicit => |value| alloc.free(value),
+    };
+    const uri = alloc.dupe(u8, try dec.slice()) catch return error.OutOfMemory;
+    return .{ .id = id, .uri = uri };
+}
+
+fn decodeCell(screen: *Screen, dec: *Decoder, y: u32, x: u32) Error!void {
+    const content_tag = std.meta.intToEnum(pagepkg.Cell.ContentTag, try dec.byte()) catch return error.StateInvariant;
+    const content = try dec.uint(u32);
+    const wide = std.meta.intToEnum(pagepkg.Cell.Wide, try dec.byte()) catch return error.StateInvariant;
+    const protected = try dec.boolean();
+    const cell_style = try decodeStyle(dec);
+    const grapheme_len = try dec.uint(u16);
+    if (grapheme_len > max_grapheme_codepoints) return error.ResourceLimit;
+    var grapheme_buf: [max_grapheme_codepoints]u21 = undefined;
+    for (grapheme_buf[0..grapheme_len]) |*cp| {
+        const value = try dec.uint(u32);
+        if (value > 0x10ffff or (value >= 0xd800 and value <= 0xdfff)) return error.StateInvariant;
+        cp.* = @intCast(value);
+    }
+    const has_link = try dec.boolean();
+    const link = if (has_link) try decodeOwnedHyperlink(screen.alloc, dec) else null;
+    defer if (link) |*value| value.deinit(screen.alloc);
+
+    while (true) {
+        const pin = screen.pages.pin(.{ .screen = .{ .y = @intCast(y), .x = @intCast(x) } }) orelse return error.StateInvariant;
+        const rac = pin.rowAndCell();
+        var cell: pagepkg.Cell = @bitCast(@as(u64, 0));
+        // Ghostty's managed grapheme API requires a plain codepoint cell and
+        // promotes it to codepoint_grapheme only after the backing data exists.
+        cell.content_tag = if (content_tag == .codepoint_grapheme) .codepoint else content_tag;
+        switch (content_tag) {
+            .codepoint, .codepoint_grapheme => {
+                if (content > 0x10ffff or (content >= 0xd800 and content <= 0xdfff)) return error.StateInvariant;
+                cell.content = .{ .codepoint = @intCast(content) };
+                if (content_tag == .codepoint_grapheme and (content == 0 or grapheme_len == 0)) return error.StateInvariant;
+                if (content_tag == .codepoint and grapheme_len != 0) return error.StateInvariant;
+            },
+            .bg_color_palette => cell.content = .{ .color_palette = @truncate(content) },
+            .bg_color_rgb => cell.content = .{ .color_rgb = .{ .r = @truncate(content >> 16), .g = @truncate(content >> 8), .b = @truncate(content) } },
+        }
+        cell.wide = wide;
+        cell.protected = protected;
+        rac.cell.* = cell;
+
+        if (!cell_style.default()) {
+            rac.cell.style_id = pin.node.data.styles.add(pin.node.data.memory, cell_style) catch |err| switch (err) {
+                error.OutOfMemory, error.NeedsRehash => {
+                    _ = screen.adjustCapacity(pin.node, .{ .styles = pin.node.data.capacity.styles * 2 }) catch return error.OutOfMemory;
+                    continue;
+                },
+            };
+            rac.row.styled = true;
+        }
+        if (grapheme_len > 0) {
+            pin.node.data.setGraphemes(rac.row, rac.cell, grapheme_buf[0..grapheme_len]) catch {
+                _ = screen.adjustCapacity(pin.node, .{ .grapheme_bytes = pin.node.data.capacity.grapheme_bytes * 2 }) catch return error.OutOfMemory;
+                continue;
+            };
+        }
+        if (link) |logical| {
+            const id = pin.node.data.insertHyperlink(logical) catch {
+                _ = screen.adjustCapacity(pin.node, .{
+                    .hyperlink_bytes = pin.node.data.capacity.hyperlink_bytes * 2,
+                    .string_bytes = pin.node.data.capacity.string_bytes * 2,
+                }) catch return error.OutOfMemory;
+                continue;
+            };
+            pin.node.data.setHyperlink(rac.row, rac.cell, id) catch {
+                _ = screen.adjustCapacity(pin.node, .{ .hyperlink_bytes = pin.node.data.capacity.hyperlink_bytes * 2 }) catch return error.OutOfMemory;
+                continue;
+            };
+        }
+        return;
+    }
+}
+
+fn addCursorStyle(screen: *Screen, value: stylepkg.Style) !stylepkg.Id {
+    if (value.default()) return stylepkg.default_id;
+    while (true) {
+        const node = screen.cursor.page_pin.node;
+        return node.data.styles.add(node.data.memory, value) catch {
+            _ = try screen.adjustCapacity(node, .{ .styles = node.data.capacity.styles * 2 });
+            continue;
+        };
+    }
+}
+
+test "checkpoint rejects corrupt envelope before constructing state" {
+    const alloc = std.testing.allocator;
+    var terminal = try Terminal.init(alloc, .{ .cols = 80, .rows = 24, .max_scrollback = 1024 * 1024 });
+    defer terminal.deinit(alloc);
+    const bytes = try capture(alloc, &terminal, &.{}, .{});
+    defer alloc.free(bytes);
+    var corrupt = try alloc.dupe(u8, bytes);
+    defer alloc.free(corrupt);
+    corrupt[header_len] ^= 0xff;
+    try std.testing.expectError(error.ChecksumMismatch, decode(alloc, corrupt, 80, 24, null));
+}
+
+test "checkpoint round trips logical terminal state" {
+    const alloc = std.testing.allocator;
+    var terminal = try Terminal.init(alloc, .{ .cols = 20, .rows = 5, .max_scrollback = 1024 * 1024 });
+    defer terminal.deinit(alloc);
+    var stream = terminal.vtStream();
+    defer stream.deinit();
+    try stream.nextSlice("one\r\ntwo\r\n\x1b[3;4H\x1b[1;38;5;201m界e\u{301}");
+    const bytes = try capture(alloc, &terminal, "\x1b[0n", .{});
+    defer alloc.free(bytes);
+    var restored = try decode(alloc, bytes, 20, 5, null);
+    defer restored.deinit(alloc);
+    const bytes2 = try capture(alloc, &restored.terminal, restored.response, .{});
+    defer alloc.free(bytes2);
+    try std.testing.expectEqualSlices(u8, bytes, bytes2);
+}
+
+fn testPrimaryExplicitMaxOffset(bytes: []const u8) Error!usize {
+    const meta = try metadata(bytes);
+    var dec: Decoder = .{ .bytes = bytes[header_len..] };
+    _ = try dec.slice();
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.byte();
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.slice();
+    _ = try decodeColors(&dec);
+    if (try dec.boolean()) _ = try dec.uint(u32);
+    _ = try dec.uint(u64);
+    _ = try dec.uint(u64);
+    _ = try dec.uint(u64);
+    _ = try dec.uint(u32);
+    _ = try dec.boolean();
+    _ = try dec.boolean();
+    _ = try dec.byte();
+    _ = try dec.byte();
+    _ = try dec.byte();
+    _ = try dec.boolean();
+    _ = try dec.boolean();
+    _ = try dec.boolean();
+    for (0..meta.cols) |_| _ = try dec.boolean();
+    _ = try dec.byte();
+    _ = try dec.boolean();
+    return header_len + dec.offset;
+}
+
+const TestTerminalOffsets = struct {
+    mouse_shape: usize,
+    mouse_shift_capture: usize,
+};
+
+fn testTerminalOffsets(bytes: []const u8) Error!TestTerminalOffsets {
+    var dec: Decoder = .{ .bytes = bytes[header_len..] };
+    _ = try dec.slice();
+    for (0..4) |_| _ = try dec.uint(u32);
+    _ = try dec.byte();
+    for (0..4) |_| _ = try dec.uint(u32);
+    _ = try dec.slice();
+    _ = try decodeColors(&dec);
+    if (try dec.boolean()) _ = try dec.uint(u32);
+    for (0..3) |_| _ = try dec.uint(u64);
+    const mouse_shape = header_len + dec.offset;
+    _ = try dec.uint(u32);
+    _ = try dec.boolean();
+    _ = try dec.boolean();
+    _ = try dec.byte();
+    _ = try dec.byte();
+    const mouse_shift_capture = header_len + dec.offset;
+    return .{ .mouse_shape = mouse_shape, .mouse_shift_capture = mouse_shift_capture };
+}
+
+const TestScreenOffsets = struct {
+    saved_cursor_x: usize,
+    kitty_flags: usize,
+};
+
+fn testScreenOffsets(alloc: Allocator, bytes: []const u8) Error!TestScreenOffsets {
+    const explicit_max = try testPrimaryExplicitMaxOffset(bytes);
+    var dec: Decoder = .{ .bytes = bytes[header_len..], .offset = explicit_max - header_len };
+    _ = try dec.uint(u64);
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.uint(u32);
+    _ = try dec.byte();
+    _ = try dec.boolean();
+    _ = try dec.boolean();
+    _ = try decodeStyle(&dec);
+    _ = try dec.uint(u32);
+    if (try dec.boolean()) {
+        var link = try decodeOwnedHyperlink(alloc, &dec);
+        link.deinit(alloc);
+    }
+    if (!try dec.boolean()) return error.StateInvariant;
+    const saved_cursor_x = header_len + dec.offset;
+    _ = try decodeSavedCursorBody(&dec);
+    _ = try decodeCharset(&dec);
+    _ = try dec.byte();
+    return .{ .saved_cursor_x = saved_cursor_x, .kitty_flags = header_len + dec.offset };
+}
+
+fn decodeSavedCursorBody(dec: *Decoder) Error!Screen.SavedCursor {
+    return .{
+        .x = @intCast(try dec.uint(u32)),
+        .y = @intCast(try dec.uint(u32)),
+        .style = try decodeStyle(dec),
+        .protected = try dec.boolean(),
+        .pending_wrap = try dec.boolean(),
+        .origin = try dec.boolean(),
+        .charset = try decodeCharset(dec),
+    };
+}
+
+fn testRewriteChecksum(bytes: []u8) void {
+    std.crypto.hash.sha2.Sha256.hash(
+        bytes[header_len..],
+        bytes[header_len - 32 ..][0..32],
+        .{},
+    );
+}
+
+test "checkpoint rejects oversized integer fields without trapping" {
+    const alloc = std.testing.allocator;
+    var terminal = try Terminal.init(alloc, .{ .cols = 80, .rows = 24, .max_scrollback = 1024 * 1024 });
+    defer terminal.deinit(alloc);
+    const original = try capture(alloc, &terminal, &.{}, .{});
+    defer alloc.free(original);
+
+    var invalid_region = try alloc.dupe(u8, original);
+    defer alloc.free(invalid_region);
+    var payload: Decoder = .{ .bytes = invalid_region[header_len..] };
+    _ = try payload.slice();
+    payload.offset += 4 * @sizeOf(u32) + @sizeOf(u8);
+    std.mem.writeInt(u32, invalid_region[header_len + payload.offset ..][0..4], std.math.maxInt(u32), .little);
+    testRewriteChecksum(invalid_region);
+    try std.testing.expectError(error.StateInvariant, decode(alloc, invalid_region, 80, 24, null));
+
+    var invalid_explicit_max = try alloc.dupe(u8, original);
+    defer alloc.free(invalid_explicit_max);
+    const explicit_max_offset = try testPrimaryExplicitMaxOffset(invalid_explicit_max);
+    std.mem.writeInt(u64, invalid_explicit_max[explicit_max_offset..][0..8], std.math.maxInt(u64), .little);
+    testRewriteChecksum(invalid_explicit_max);
+    try std.testing.expectError(error.ResourceLimit, decode(alloc, invalid_explicit_max, 80, 24, null));
+}
+
+test "checkpoint rejects invalid enums and saved cursor coordinates" {
+    const alloc = std.testing.allocator;
+    var terminal = try Terminal.init(alloc, .{ .cols = 80, .rows = 24, .max_scrollback = 1024 * 1024 });
+    defer terminal.deinit(alloc);
+    var stream = terminal.vtStream();
+    defer stream.deinit();
+    try stream.nextSlice("\x1b[4;8H\x1b7");
+    const original = try capture(alloc, &terminal, &.{}, .{});
+    defer alloc.free(original);
+
+    const terminal_offsets = try testTerminalOffsets(original);
+    var invalid_mouse_shape = try alloc.dupe(u8, original);
+    defer alloc.free(invalid_mouse_shape);
+    std.mem.writeInt(u32, invalid_mouse_shape[terminal_offsets.mouse_shape..][0..4], std.math.maxInt(u32), .little);
+    testRewriteChecksum(invalid_mouse_shape);
+    try std.testing.expectError(error.StateInvariant, decode(alloc, invalid_mouse_shape, 80, 24, null));
+
+    var invalid_mouse_shift = try alloc.dupe(u8, original);
+    defer alloc.free(invalid_mouse_shift);
+    invalid_mouse_shift[terminal_offsets.mouse_shift_capture] = 0xff;
+    testRewriteChecksum(invalid_mouse_shift);
+    try std.testing.expectError(error.StateInvariant, decode(alloc, invalid_mouse_shift, 80, 24, null));
+
+    const screen_offsets = try testScreenOffsets(alloc, original);
+    var invalid_saved_x = try alloc.dupe(u8, original);
+    defer alloc.free(invalid_saved_x);
+    std.mem.writeInt(u32, invalid_saved_x[screen_offsets.saved_cursor_x..][0..4], std.math.maxInt(u32), .little);
+    testRewriteChecksum(invalid_saved_x);
+    try std.testing.expectError(error.StateInvariant, decode(alloc, invalid_saved_x, 80, 24, null));
+
+    var invalid_kitty_flags = try alloc.dupe(u8, original);
+    defer alloc.free(invalid_kitty_flags);
+    invalid_kitty_flags[screen_offsets.kitty_flags] = 0xff;
+    testRewriteChecksum(invalid_kitty_flags);
+    try std.testing.expectError(error.StateInvariant, decode(alloc, invalid_kitty_flags, 80, 24, null));
+}
